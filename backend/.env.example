# Copy this file to .env and fill in real values. Never commit .env.

# Django
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme-generate-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - comma-separated list of origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
# Set USE_SQLITE=True for zero-setup local dev (no MySQL needed).
USE_SQLITE=True

# Only required when USE_SQLITE=False (i.e. using MySQL):
DB_NAME=fitness
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
